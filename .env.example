# FIDS API authentication. Keep this secret.
FIDS_API_KEY=replace-with-a-long-random-secret

# Supabase project settings. Keep the service role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Discord bot settings.
DISCORD_TOKEN=replace-with-your-discord-bot-token
DISCORD_CLIENT_ID=replace-with-your-discord-application-client-id
# Optional: guild/server ID for instant command registration during development.
DISCORD_GUILD_ID=
# Text channel where /weekly-flight is allowed and where the automatic Sunday post is sent.
WEEKLY_FLIGHT_CHANNEL_ID=replace-with-your-weekly-flight-channel-id
# FIDS HTTP base URL. Use the local default for development or your deployed FIDS URL in production.
FIDS_BASE_URL=http://127.0.0.1:3000
